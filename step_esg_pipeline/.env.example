# Environment variables for STEP ESG Link Monitoring Pipeline
# Copy this file to .env and fill in your values.

# Database configuration
STEP_DB_PATH=step_esg_links.db

# HTTP settings
STEP_HTTP_TIMEOUT=30
STEP_HTTP_MAX_RETRIES=2

# AI Provider Configuration
# STEP_AI_PROVIDER=anthropic|openai|gemini|mock
STEP_AI_PROVIDER=mock

# Anthropic Claude
ANTHROPIC_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# STEP/Kajabi write access (not implemented in MVP)
# STEP_API_KEY=
# STEP_API_SECRET=
